# PostgreSQL criado no Marketplace da Vercel (Neon)
DATABASE_URL=

# APP_PASSWORD: senha com pelo menos 16 caracteres; SESSION_SECRET: chave aleatória com pelo menos 32 caracteres
APP_PASSWORD=
SESSION_SECRET=

# Use o mesmo segredo no GitHub Actions > Repository secrets
CRON_SECRET=

# Integrações opcionais
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0

# JSON array, por exemplo: [{"name":"Ofertas","url":"https://exemplo.com/rss.xml"}]
RSS_FEEDS=[]
